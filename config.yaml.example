server:
  port: "8080"

mysql:
  dsn: "user:password@tcp(localhost:3306)/bssm_dev?charset=utf8mb4&parseTime=True&loc=Local"
  max_open_conns: 50
  max_idle_conns: 10
  conn_max_lifetime: 5m

redis:
  addr: "localhost:6379"
  password: ""
  db: 0
  pool_size: 100

mongodb:
  uri: "mongodb://localhost:27017"
  database: "bssm_dev"

cache:
  local_ttl: 5m
  redis_ttl: 10m

log:
  workers: 4
  level: info    # debug | info | warn | error

queue:
  max_inflight: 80
  acquire_timeout: 1s
  base_priority: 1.0
  priority_increment: 0.2
  max_priority: 3.0

rate_limit:
  enabled: true          # dev 환경에서는 false로 설정
  threshold_multiplier: 200

cors:
  allowed_origins:
    - "https://bssmdev.com"
    - "https://dev.bssm-dev.com"
    - "http://localhost"
    - "https://localhost"
